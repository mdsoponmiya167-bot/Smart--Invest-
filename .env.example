NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:password@localhost:5432/smartinvest
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-admin-password
SSL_MODE=sandbox
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
# Keep false. This starter records verified sandbox payments but does not credit an investment wallet.
ENABLE_WALLET_CREDIT=false
